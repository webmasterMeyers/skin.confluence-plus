<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<controls>
		<include>CommonBackground</include>
		<control type="group">
			<depth>DepthHeader</depth>
			<control type="image">
				<description>Section header image</description>
				<left>20</left>
				<top>3</top>
				<width>35</width>
				<height>35</height>
				<aspectratio>keep</aspectratio>
				<texture>icon_power.png</texture>
			</control>
			<control type="label">
				<left>65</left>
				<top>5</top>
				<width>1000</width>
				<height>30</height>
				<font>font13_title</font>
				<textcolor>white</textcolor>
				<label>APPLICATIONS</label>
			</control>
			<include>Clock</include>
		</control>
		<control type="list" id="50">
			<left>40</left>
			<top>100</top>
			<width>1200</width>
			<height>600</height>
			<onleft>50</onleft>
			<onright>50</onright>
			<onup>50</onup>
			<ondown>50</ondown>
			<itemlayout height="80" width="1200">
				<control type="image">
					<left>10</left>
					<top>5</top>
					<width>70</width>
					<height>70</height>
					<aspectratio>keep</aspectratio>
					<texture>DefaultProgram.png</texture>
				</control>
				<control type="label">
					<left>100</left>
					<top>0</top>
					<width>1000</width>
					<height>80</height>
					<font>font16</font>
					<textcolor>grey2</textcolor>
					<align>left</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout height="80" width="1200">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1200</width>
					<height>80</height>
					<texture border="5">listselect_fo.png</texture>
				</control>
				<control type="image">
					<left>10</left>
					<top>5</top>
					<width>70</width>
					<height>70</height>
					<aspectratio>keep</aspectratio>
					<texture>DefaultProgram.png</texture>
				</control>
				<control type="label">
					<left>100</left>
					<top>0</top>
					<width>1000</width>
					<height>80</height>
					<font>font16</font>
					<textcolor>white</textcolor>
					<align>left</align>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
			<content>
				<item>
					<label>Shotwell</label>
					<onclick>System.Exec(shotwell)</onclick>
					<thumb>DefaultProgram.png</thumb>
				</item>
				<item>
					<label>BackInTime</label>
					<onclick>System.Exec(backintime-qt4)</onclick>
					<thumb>DefaultProgram.png</thumb>
				</item>
			</content>
		</control>
	</controls>
</window> 